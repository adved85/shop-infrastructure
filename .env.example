# Copy this file to .env.prod and fill in real values.
# .env.prod is git-ignored on purpose — never commit real secrets.
# See docs/environment.md for a full explanation of every variable below.

# ---- PostgreSQL ----
POSTGRES_DB=laravel_shop_api
POSTGRES_USER=shop_user
# Generate a real value with: openssl rand -base64 32
POSTGRES_PASSWORD=CHANGE_ME

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379

# ---- RabbitMQ ----
# These two create the broker's user. compose.yml passes the same values to the
# api container under the different names Laravel reads (RABBITMQ_USER /
# RABBITMQ_PASSWORD), so there is only one place to change a credential.
RABBITMQ_DEFAULT_USER=shop_user
# Generate a real value with: openssl rand -base64 32
RABBITMQ_DEFAULT_PASS=CHANGE_ME

# ---- Image versions ----
# Must match a tag actually published to GHCR by each app repo's
# docker-publish.yml workflow (triggered by pushing a git tag like v0.1.0).
API_VERSION=0.1.0
FRONTEND_VERSION=0.1.1
